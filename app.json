{
  "expo": {
    "name": "PhotoResizer",
    "slug": "photoresiz-mobile-app-jvcg81g1",
    "version": "1.0.7",
    "owner": "jamesrcsmith",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "photoresizer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.photoresizer.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PhotoResizer needs access to your photos to resize them. Photos stay on your device.",
        "NSPhotoLibraryAddUsageDescription": "PhotoResizer needs permission to save resized images to your library.",
        "NSCameraUsageDescription": "PhotoResizer can take a photo to resize.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "ca.photoresizer.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PhotoResizer needs access to your photos to resize them. Photos stay on your device.",
          "cameraPermission": "PhotoResizer can take a photo to resize."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PhotoResizer needs permission to save resized images to your library.",
          "savePhotosPermission": "PhotoResizer needs permission to save resized images to your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cdd406fe-849f-490b-b674-e221a7952620"
      },
      "websiteUrl": "https://photoresizer.ca",
      "supportUrl": "https://photoresizer.ca/support",
      "privacyUrl": "https://photoresizer.ca/privacy"
    }
  }
}
